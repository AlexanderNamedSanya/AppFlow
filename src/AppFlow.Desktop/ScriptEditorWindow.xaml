<ui:FluentWindow x:Class="AppFlow.Desktop.ScriptEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Добавить скрипт" Icon="{StaticResource AppFlowIcon}" Width="740" Height="620" MinWidth="540" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Background="Transparent" FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:TitleBar Title="Добавить скрипт" ShowMinimize="False" ShowMaximize="False"><ui:TitleBar.Icon><ui:ImageIcon Source="{StaticResource AppFlowIcon}"/></ui:TitleBar.Icon></ui:TitleBar>
  <Border Grid.Row="1" Margin="8,0,8,8" Padding="24" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Новый скрипт" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0"><TextBlock Text="Название" Margin="0,0,0,8"/><ui:TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Название действия" AutomationProperties.Name="Название скрипта"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Тип скрипта" Margin="0,0,0,8"/><ComboBox SelectedValue="{Binding Extension}" SelectedValuePath="Tag" AutomationProperties.Name="Тип скрипта"><ComboBoxItem Content="PowerShell (.ps1)" Tag=".ps1"/><ComboBoxItem Content="CMD (.cmd)" Tag=".cmd"/><ComboBoxItem Content="BAT (.bat)" Tag=".bat"/></ComboBox></StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Text="Текст скрипта" Margin="0,20,0,8"/>
    <TextBox Grid.Row="3" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="12" AutomationProperties.Name="Текст скрипта"/>
    <StackPanel Grid.Row="4" Margin="0,16,0,0">
     <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,12"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/><ui:Button Content="Добавить" Appearance="Primary" IsEnabled="{Binding CanAdd}" Click="OnAdd"/></StackPanel>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</ui:FluentWindow>
